# Generated by XcodeGen in CI — project.yml is the source of truth
*.xcodeproj/
*.xcworkspace/
.swiftpm/

# Build output
DerivedData/
.build/
build/
*.ipa
*.dSYM.zip
*.log

# Secrets / signing — never commit
*.p12
*.mobileprovision
*.p8
*.cer
.env
.env.*

# OS / editor
.DS_Store
Thumbs.db
.vscode/
xcuserdata/

# TestFlight feedback pulled by tools/asc_feedback.py (screenshots may contain personal text)
.feedback/
__pycache__/

